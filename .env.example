# ============================================================
# 自助式数据分析 Agent 平台 .env 模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env:    copy .env.example .env   (Windows)
#                          cp .env.example .env     (macOS/Linux)
#   2. 把 your_* 替换为真实值
#   3. 永远不要把 .env 提交到 git（已经在 .gitignore 里了）
# ============================================================

# ----- FastAPI 后端 -----
API_HOST=127.0.0.1
API_PORT=8000

# ----- SQLite 持久化路径（阶段 2）-----
# 默认落到项目根目录的 data/daa.db
# 不配也行；配了就能放到其它位置（例如外部磁盘）
# DAA_SQLITE_PATH=data/daa.db

# ----- OpenAI 兼容 LLM 配置 -----
# 这是本项目的"Agent 内核"：自然语言 → 结构化意图 JSON → 后端受控执行
# 三家现成供应商任选其一：
#   OpenAI:     https://api.openai.com/v1   | gpt-4o-mini
#   DeepSeek:   https://api.deepseek.com/v1  | deepseek-chat
#   硅基流动:    https://api.siliconflow.cn/v1 | ...（按平台模型列表选）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0

# 不配 LLM_API_KEY 也能跑：
# 自然语言意图识别会自动降级到关键词匹配（"占比/分布" → 饼图，"趋势" → 折线图...）
# API 响应里 "意图来源" 字段会显示 "规则" / "LLM" / "无"

# ----- Streamlit 调试前端访问 FastAPI 的地址 -----
# （HTML 主前端不依赖这个，Streamlit 仅作内部调试入口）
AGENT_API_BASE_URL=http://127.0.0.1:8000
AGENT_API_TIMEOUT=120

# ----- SMTP 邮件（阶段十三：邮箱验证码注册）-----
# 不配置 SMTP_HOST 时自动 dry-run：验证码打印到后端日志，本地调试可跑通全流程
# 想真实发邮件：填下面 5 项（QQ/163 邮箱需用【授权码】而非登录密码）
#   QQ:    SMTP_HOST=smtp.qq.com    SMTP_PORT=465
#   163:   SMTP_HOST=smtp.163.com   SMTP_PORT=465
# SMTP_USER=your_email@qq.com
# SMTP_PASS=your_authorization_code
# SMTP_FROM=your_email@qq.com
# SMTP_DRY_RUN=false

# ----- 种子管理员（阶段十三）-----
# 启动时幂等创建；默认 admin/admin123 仅限本地，生产务必修改密码！
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=change-this-admin-password