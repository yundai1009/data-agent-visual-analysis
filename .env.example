# ============================================================
# 自助式数据分析 Agent 平台 .env 模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env:    copy .env.example .env   (Windows)
#                          cp .env.example .env     (macOS/Linux)
#   2. 把 your_* 替换为真实值
#   3. 永远不要把 .env 提交到 git（已经在 .gitignore 里了）
#
# 【必读】EnvConfig 的所有属性在**进程 import 时求值一次**：
#   改完 .env 必须重启后端，否则读到的还是旧值。
#   （"配置项写了却不生效"最难查的一类问题，先确认重启过。）
#
# 【必读】下面标了「启动自检」的三项没配好，服务会**直接拒绝启动**而不是降级运行：
#   AUTH_ENABLED / JWT_SECRET_KEY / SEED_ADMIN_PASSWORD
# ============================================================

# ============================================================
# 一、启动自检（必配，否则拒绝启动）
# ============================================================

# 认证总开关。**必须显式设置**，没有默认值——
#   认证开关的「没配」和「配了 false」必须严格区分：按关闭处理会让用户忘记配置时
#   全站匿名可访问，强制显式声明把「忘记配置」变成「启动失败」而非「裸奔上线」。
#   演示/本地调试：false
#   生产/测试：  true
# AUTH_ENABLED=true

# JWT 签名密钥。AUTH_ENABLED=true 时必填，且不能留默认值
#（默认值 "change-me-in-production" 公开写在代码里，可据此伪造任意身份的 token）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 已知取舍（R6）：同一个值也被用来派生 LLM Key 的加密密钥与分享链接密码的 HMAC，
#   三处共用一把钥匙——泄其一即泄其三。
# JWT_SECRET_KEY=your-strong-random-secret

# 种子管理员口令。AUTH_ENABLED=true 时必须覆盖默认值（admin123 公开已知）。
# 启动时幂等创建；**只在账户不存在时创建**。若已存在同名非管理员用户，会直接报错
# 拒绝静默提权，而不是把它升级成管理员——请换一个 SEED_ADMIN_USERNAME 再重启。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(24))"
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=your-strong-admin-password

# Token 有效期（分钟），默认 60
# JWT_EXPIRE_MINUTES=60
# JWT_ALGORITHM=HS256

# ============================================================
# 二、向量记忆（阶段六十一）
# ============================================================
# 【必读】一个向量库只能有一个语义空间，所以 embedding 的三要素必须与**建库时**一致：
#   库里的指纹（base_url + model + 向量化文本模板）与当前配置不一致 → 启动自检第 6 道
#   直接拒绝启动。**换 embedding 模型 = 重建库**，没有增量迁移。重建就跑：
#     python scripts/重建记忆库.py --dry-run   # 先看要删多少条
#     python scripts/重建记忆库.py --yes       # 确认后删除并按当前配置重建
#   （两者都必须显式给——删的是不可恢复的用户长期记忆，默认动作必须是"什么都不做"。）
# 【坑】指纹硬闸**只对新建库有效**：老库缺指纹字段时按"未知放行"，换模型不会被拦住，
#   也就不会有启动失败提醒你，得自己记得跑上面的脚本。
# 【必读】embedding 的三要素和 chat 的三要素是**分开配**的：拿 chat 的 Key 去请求
#   embedding 端点会 401，模型名对不上会 400。留空时 base_url/model 回落到
#   LLM_BASE_URL / text-embedding-3-small，但 Key 不会回落到 LLM_API_KEY。
# LLM_EMBEDDING_BASE_URL=https://api.deepseek.com/v1
# LLM_EMBEDDING_MODEL=deepseek-embedding
# LLM_EMBEDDING_API_KEY=your_embedding_api_key

# 向量库目录，默认 data/chroma_db。备份数据库时**这个目录要一起备**。
# DAA_CHROMA_PATH=data/chroma_db

# 容量治理：都是**软上限**——两次扫描之间最多超 MEMORY_CLEAN_STEP 条。
# 单用户配额，防止一个疯狂分析的重用户把别人的记忆挤掉。
# MEMORY_PER_USER_LIMIT=200
# 全库硬上限兜底。
# MEMORY_TOTAL_LIMIT=5000
# 水位摊销步长：每 MEMORY_CLEAN_STEP 次写入才做一次全库扫描。
# MEMORY_CLEAN_STEP=50

# ============================================================
# 三、OpenAI 兼容 LLM
# ============================================================
# 这是本项目的"Agent 内核"：自然语言 → 结构化意图 JSON → 后端受控执行。
# 供应商清单在 config/providers.toml（18 家），不在本文件里配。
# 不配 LLM_API_KEY 也能跑：自然语言意图识别自动降级到关键词匹配
# （"占比/分布" → 饼图，"趋势" → 折线图…），响应里「意图来源」会显示 规则 / LLM / 无。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your_llm_api_key
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=2048

# 账号级 LLM Key（BYOK）。每个用户可以在前端填自己的 Key，服务端用
# LLM_KEY_ENCRYPTION_KEY 加密后落库。优先级：
#   X-LLM-API-Key 请求头 > 账号 BYOK > provider 的 api_key_env > 本文件的 LLM_API_KEY
# 留空则从 JWT_SECRET_KEY 的 SHA-256 派生（本地开发兼容，生产请显式设置）：
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# LLM_KEY_ENCRYPTION_KEY=your-fernet-key

# 配额（每账号每天），默认 100 万 token / 200 次请求
# LLM_DAILY_TOKEN_QUOTA=1000000
# LLM_DAILY_REQUEST_QUOTA=200

# ============================================================
# 四、存储后端
# ============================================================
# 存储后端抽象：sqlite（默认，零依赖）或 mysql。
# 切 MySQL 前请先跑 scripts/migrate_sqlite_to_mysql.py 搬数据。
# DB_BACKEND=sqlite
# DAA_SQLITE_PATH=data/daa.db
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=daa_app
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=daa

# ============================================================
# 五、服务与跨域
# ============================================================
API_HOST=127.0.0.1
API_PORT=8000
API_VERSION=0.1.0

# CORS 白名单（逗号分隔）。**不是 "*"**——改了要同步改前端 dev server 地址，
# 否则浏览器直接被 CORS 拦掉，且报错常被误判成后端挂了。
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000

# 前端静态产物目录（打包版由 electron 指到 dist，非打包走 vite dev）
# FRONTEND_DIST=frontend/dist

# 报表生成的并发上限。留空=自动（按 CPU）。设大了会在多用户下抢内存。
# DAA_GENERATE_CONCURRENCY=4

# ============================================================
# 六、邮件（邮箱验证码注册）
# ============================================================
# 不配置 SMTP_HOST 时自动 dry-run：验证码打印到后端日志，本地可跑通全流程。
# 想真实发邮件：填下面 5 项（QQ/163 需用【授权码】而非登录密码）
#   QQ:  SMTP_HOST=smtp.qq.com  SMTP_PORT=465
#   163: SMTP_HOST=smtp.163.com SMTP_PORT=465
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=your_email@qq.com
# SMTP_PASS=your_authorization_code
# SMTP_FROM=your_email@qq.com
# SMTP_DRY_RUN=false

# ============================================================
# 七、演示模式（仅本地）
# ============================================================
# 前端的 AUTH_REQUIRED 读的是 frontend/.env.demo 的 VITE_AUTH_REQUIRED=false，
# 配合上面 AUTH_ENABLED=false 才能真正免登录；生产部署不要带这两个。