# 本地密钥与环境变量
.env

# Python 缓存
__pycache__/
*.py[cod]

# Streamlit/工具缓存
.streamlit/secrets.toml

# Reasonix 框架工作目录（运行时元数据，与项目代码无关）
.reasonix/

# 一键启动脚本运行时产物（已包含在 .reasonix/，保留显式说明）
# .reasonix/run/

# SQLite 持久化文件（阶段 2）
data/daa.db
data/daa.db-journal
data/daa.db-wal
data/daa.db-shm

# 上传文件副本缓存（用户上传的 CSV/Excel 副本，不进仓库）
data/uploads/

# 项目根目录下散落的历史测试 CSV（防止误提交）
data/*.csv
data/*.xls
data/*.xlsx
